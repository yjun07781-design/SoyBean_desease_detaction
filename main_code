@app.route('/preview_frame')
def preview_frame():
    if not camera_lock.acquire(blocking=False): return "Camera Busy", 503
    try:
        subprocess.run(["rpicam-jpeg", "-o", "preview.jpg", "-t", "10", "--width", "640", "--height", "480", "-n"], check=True)
        return send_file("preview.jpg", mimetype='image/jpeg')
    except Exception as e: return str(e), 500
    finally: camera_lock.release()

@app.route('/capture')
def capture():
    global last_saved_timestamp
    if model is None: return jsonify({"success": False, "message": "模型未加载！"})
    
    with camera_lock:
        try:
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            last_saved_timestamp = timestamp 
            
            subprocess.run(["rpicam-jpeg", "-o", "temp.jpg", "-t", "2000", "--width", "640", "--height", "480", "-n", "--autofocus-mode", "auto"], check=True)
            frame = cv2.imread("temp.jpg")
            h, w, _ = frame.shape
            
            processed_img = frame.copy() 
            grid_img = frame.copy()      
            
            results = model(frame, conf=0.3, verbose=False)
            processed_img = results[0].plot() 
            
            box_masks = []
            names = model.names
            for box in results[0].boxes:
                cls_id = int(box.cls[0])
                cls_name = names[cls_id].lower()
                
                if 'health' in cls_name or '健康' in cls_name or 'normal' in cls_name:
                    continue
                    
                bx1, by1, bx2, by2 = map(int, box.xyxy[0])
                bx1, by1 = max(0, bx1), max(0, by1)
                bx2, by2 = min(w, bx2), min(h, by2)
                if bx2 > bx1 and by2 > by1:
                    roi = frame[by1:by2, bx1:bx2]
                    mask = extract_lesion_mask(roi)
                    box_masks.append((bx1, by1, bx2, by2, mask))

            h_s, w_s = h // 3, w // 3
            best_grid = None
            max_sti = -1
            all_grids_sti = []
            csv_rows = [] 
            
            for r in range(3):
                for c in range(3):
                    y1, y2, x1, x2 = r*h_s, (r+1)*h_s, c*w_s, (c+1)*w_s
                    cv2.rectangle(processed_img, (x1, y1), (x2, y2), (255, 200, 0), 2)
                    cv2.rectangle(grid_img, (x1, y1), (x2, y2), (255, 200, 0), 2)
                    
                    roi = frame[y1:y2, x1:x2]
                    g_ratio = calculate_green_ratio(roi)
                    g_pixels = g_ratio * h_s * w_s
                    
                    d_pixels = 0
                    for (bx1, by1, bx2, by2, mask) in box_masks:
                        ix1, ix2 = max(x1, bx1), min(x2, bx2)
                        iy1, iy2 = max(y1, by1), min(y2, by2)
                        if ix1 < ix2 and iy1 < iy2:
                            mx1, mx2 = ix1 - bx1, ix2 - bx1
                            my1, my2 = iy1 - by1, iy2 - by1
                            lesion_slice = mask[my1:my2, mx1:mx2]
                            d_pixels += cv2.countNonZero(lesion_slice)
                    
                    d_idx = d_pixels / (g_pixels + 1e-5)
                    sti = 0
                    if g_ratio > 0.05:
                        sti = 100 * g_ratio * np.exp(-8.0 * (d_idx ** 2))
                    
                    all_grids_sti.append(float(sti))
                    csv_rows.append([timestamp, r+1, c+1, round(g_ratio, 4), round(d_idx, 4), round(sti, 2)])
                    
                    if sti > max_sti and sti > 1.0:
                        max_sti = sti
                        best_grid = (x1, y1, x2, y2, r, c)

            with open(CSV_FILE, mode='a', newline='', encoding='utf-8-sig') as f:
                writer = csv.writer(f)
                writer.writerows(csv_rows)

            msg = f"共处理 {len(results[0].boxes)} 个目标框。"
            selected_grid_str = ""
            if best_grid:
                x1, y1, x2, y2, r, c = best_grid
                selected_grid_str = f"第{r+1}行 第{c+1}列"
                cv2.rectangle(processed_img, (x1, y1), (x2, y2), (0, 255, 0), 8)
                cv2.putText(processed_img, f"TARGET STI: {max_sti:.1f}", (x1+5, y1+35), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 3)
            else: msg += "无达标抗逆植株。"

            cv2.imwrite("grid_only_photo_ui.jpg", grid_img)
            cv2.imwrite("processed_result_ui.jpg", processed_img)
            
            return jsonify({
                "success": True, 
                "message": msg, 
                "timestamp": timestamp,
                "processed_url": "/get_processed_image",
                "grid_url": "/get_grid_image",
                "selected_sti": float(max_sti) if max_sti > 0 else 0,
                "all_grids_sti": all_grids_sti,
                "selected_grid": selected_grid_str
            })
        
        except Exception as e: return jsonify({"success": False, "message": str(e)})

@app.route('/delete_last')
def delete_last():
    global last_saved_timestamp
    if not last_saved_timestamp: return jsonify({"success": False, "message": "目前没有可撤销的记录"})
    
    try:
        if os.path.exists(CSV_FILE):
            with open(CSV_FILE, mode='r', encoding='utf-8-sig') as f:
                lines = list(csv.reader(f))
            if len(lines) > 0:
                new_lines = [lines[0]] + [row for row in lines[1:] if row and row[0] != last_saved_timestamp]
                with open(CSV_FILE, mode='w', newline='', encoding='utf-8-sig') as f:
                    writer = csv.writer(f)
                    writer.writerows(new_lines)
        
        last_saved_timestamp = None
        return jsonify({"success": True, "message": "已成功在数据表中剔除上一张废片的所有数据！"})
    except Exception as e: return jsonify({"success": False, "message": f"删除失败: {str(e)}"})

