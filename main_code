# =======================
# 图像算法模块
# =======================
def calculate_green_ratio(roi_image):
    img_float = np.float32(roi_image)
    B, G, R = cv2.split(img_float)
    
    denom = R + G + B
    denom[denom == 0] = 1
    r, g, b = R / denom, G / denom, B / denom
    
    # ExG (超绿指数) 
    exg = 2 * g - r - b
    
    # 物理学绝对阈值（学术界公认的绿叶/泥土分割线）
    PHYSICAL_THRESH = 0.05
    
    exg_max = np.max(exg)
    exg_min = np.min(exg)
    
    # 【振幅拦截器 1】：纯泥土/水泥陷阱拦截
    # 如果这个格子连最亮的地方都没达到及格线，它绝对是背景
    # 直接给 0%，彻底断绝 Otsu 拉伸背景的可能
    if exg_max < PHYSICAL_THRESH:
        return 0.0
        
    # 【振幅拦截器 2】：纯茂密绿叶陷阱拦截
    # 如果这个格子连最暗的地方都及格了，它绝对是满铺的健康树冠
    # 直接给 100%，彻底断绝 Otsu 强行把绿叶涂黑的可能
    if exg_min > PHYSICAL_THRESH:
        return 1.0
    
    # 【安全放行】：既有泥土又有绿叶的混合区
    # 这个时候，局部 NORM_MINMAX 和 Otsu 才能发挥它们应有的光斑分割实力
    exg_normalized = cv2.normalize(exg, None, alpha=0, beta=255, norm_type=cv2.NORM_MINMAX, dtype=cv2.CV_8U)
    _, mask = cv2.threshold(exg_normalized, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    
    # 【底线兜底】：无论 Otsu 选出了什么形状的白色，它在物理上必须大于 0.05
    _, real_green_mask = cv2.threshold(exg, PHYSICAL_THRESH, 255, cv2.THRESH_BINARY)
    final_mask = cv2.bitwise_and(mask, np.uint8(real_green_mask))
    
    total_pixels = roi_image.shape[0] * roi_image.shape[1]
    return cv2.countNonZero(final_mask) / total_pixels

def extract_lesion_mask(leaf_roi):
    if leaf_roi.size == 0: return np.zeros((1,1), dtype=np.uint8)
    hsv = cv2.cvtColor(leaf_roi, cv2.COLOR_BGR2HSV)
    lower = np.array([10, 40, 20])
    upper = np.array([35, 255, 255]) 
    mask = cv2.inRange(hsv, lower, upper)
    kernel = np.ones((3,3), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
    return mask

